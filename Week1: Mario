
#include <cs50.h>
#include <stdio.h>

const int HEIGHT = 10;

int main(void)
{
    for (int row = 1; row <= HEIGHT; row++)
    {
        for (int space = 0; space < HEIGHT - row; space++)
        {
            printf(" ");
        }

        for (int hash = 0; hash < row; hash++)
        {
            printf("#");
        }

        printf("  ");

        for (int hash = 0; hash < row; hash++)
        {
            printf("#");
        }

        printf("\n");
    }
}
